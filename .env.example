# ====== k8s-ops-agent 环境变量模板 ======
# 复制为 .env 后按实际填写。
# [必填] 项缺失时对应入口会报错；[可选] 项可留空或删除（有默认值）。

# === LLM 配置（OpenAI 兼容接口）—— CLI 与飞书均必填 ===
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 以下两项有默认值，可省略
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=500

# === MCP Server 配置文件路径（默认 mcp_servers.json，可省略）===
# MCP_SERVERS_FILE=mcp_servers.json

# === 搜索工具（默认 duckduckgo，可省略）===
# SEARCH_PROVIDER=duckduckgo

# === Agent 循环控制（ReAct 最大工具调用轮数，防死循环，默认 8，可省略）===
# MAX_TOOL_ROUNDS=8

# === 飞书机器人（仅 start_lark.py 需要，跑 CLI 可忽略本段）===
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
# 卡片流式更新节流间隔，默认 800 毫秒，可省略
# LARK_CARD_UPDATE_INTERVAL_MS=800
