# ====== k8s-ops-agent 环境变量模板 ======
# 复制为 .env 后按实际填写。所有变量必填，不留默认值。

# === LLM 配置（OpenAI 兼容接口）===
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# === MCP Server 配置文件路径 ===
MCP_SERVERS_FILE=mcp_servers.json

# === 搜索工具 ===
SEARCH_PROVIDER=duckduckgo

# === 飞书机器人 ===
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx
LARK_CARD_UPDATE_INTERVAL_MS=800
